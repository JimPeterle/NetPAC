# NetPAC configuration template
#
# Copy this file and fill in your values:
#   cp secret_examples.env secret.env
#
# secret.env is excluded from Git (.gitignore), so updates via "git pull"
# never overwrite it. Keep a backup of it — without the ENCRYPTION_KEY,
# stored secrets can no longer be decrypted.

# Encrypts the stored secrets, RADIUS shared secret and Git token in the database.
# Must be a Fernet key, generate it with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never change it after the first start, otherwise stored secrets become unreadable.
ENCRYPTION_KEY=

# Signs session cookies. Any long random string, e.g. generated with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Changing it logs out all users.
FLASK_KEY=

# Database connection (user and database created as described in the README)
DB_USER=
DB_PW=
DB_IP=127.0.0.1
DB_PORT=3306
